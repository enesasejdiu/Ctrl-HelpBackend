# Copy to .env and fill in. src/config.js checks these when the server or a database script starts.

PORT=5050

# Database server and database name
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Leave empty if the user has no password (e.g. XAMPP's root), but keep the line
DB_PASSWORD=your_mysql_password
DB_NAME=ticketflow

# Signs the login sessions. In production (NODE_ENV=production) the server refuses to start unless it is at least
# 32 characters and not a placeholder like the one below. Generate a real secret with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string

# The frontend's address (CORS and cookies). Must be https in production.
CLIENT_URL=http://localhost:5173

# Where attachment files are kept. Optional: the default is ./uploads in this folder (git ignores it). A relative path
# counts from this folder. Must be outside anything served statically (the server refuses folders named public, dist,
# static, www, htdocs or html); files are only reachable through GET /api/attachments/:id/download. Back it up with
# the database: the database only has the names.
# UPLOAD_DIR=./uploads

# development (default) or production. production turns the config warnings into errors, makes cookies Secure, etc.
# NODE_ENV=production

# How much the API logs (README: "Logs"): fatal, error, warn, info (default), debug, trace or silent. debug adds more
# detail for troubleshooting. Production writes one JSON line per entry; development prints them readably.
# LOG_LEVEL=info

# Production only: how many proxies are in front of the API (1 = nginx, the default; 2 = Caddy → nginx). Behind too
# few, every user looks like the proxy (one shared login limit, useless IPs in the audit log); too many lets a client
# fake its address with X-Forwarded-For.
# TRUST_PROXY_HOPS=1

# Error tracking with Sentry (README: "Error tracking"). Optional: without SENTRY_DSN nothing is sent anywhere. Only
# server errors (5xx) and crashes are sent, with the request id, method, route and user id; never personal data.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Tells deployments apart in Sentry; default NODE_ENV. Use the same value as the frontend's VITE_SENTRY_ENVIRONMENT.
# SENTRY_ENVIRONMENT=production
# Which version an error came from; default ticketflow-backend@<package.json version>. E.g. the git commit:
#   SENTRY_RELEASE=ticketflow-backend@$(git rev-parse --short HEAD)
# SENTRY_RELEASE=

# Email (README: "Email"). Placeholders only: never commit real SMTP credentials.
# Email is set up when MAIL_ENABLED=true and SMTP_HOST and MAIL_FROM are set: then new and reset passwords go out as
# one-time links (48 hours). Otherwise emails are only logged (to and subject) and admins get temporary passwords, as
# before. In production MAIL_ENABLED=true also needs an https APP_URL. To catch emails locally, run Mailpit and use
# MAIL_ENABLED=true, SMTP_HOST=localhost, SMTP_PORT=1025.
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true = TLS from the start (usually port 465); false = STARTTLS when the server offers it (587)
SMTP_SECURE=false
# Set both, or leave both empty for a server without login
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="TicketFlow <no-reply@example.com>"
# The frontend address, for the links in emails (development falls back to CLIENT_URL)
APP_URL=http://localhost:5173
# Optional shared IT inbox for new tickets; leave empty to email every active agent instead
IT_NOTIFY_EMAIL=

# The daily auto-close job (README: "Auto-close"): when it runs. The defaults close resolved tickets every day at 03:00
# Budapest time; how many days they stay resolved first is the auto_close_days setting (PATCH /api/settings).
# AUTO_CLOSE_CRON=0 3 * * *
# AUTO_CLOSE_TIMEZONE=Europe/Budapest
