# Settings for the Docker Compose setup (deploy/docker-compose.yml). Copy to deploy/.env and fill in:
#   cp .env.example .env
# deploy/.env holds passwords and the session secret: it is git-ignored, never commit it, and keep it readable only
# by you (chmod 600 .env). The API checks these when it starts and refuses weak or missing ones (it runs with
# NODE_ENV=production).

# --- Database (the db service, MySQL 8.4) ---
# Used only when the data volume is created (the first `docker compose up`). Changing them later does NOT change the
# passwords inside MySQL; change them there first (ALTER USER), then here.
# Generate each password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# (or: openssl rand -hex 24)
MYSQL_ROOT_PASSWORD=
# The app's database and its own user, which may only use that database. The API connects as this user.
DB_NAME=ticketflow
DB_USER=ticketflow
DB_PASSWORD=

# --- Backups (the backup service; README "Backups") ---
# The MySQL user the daily backups are made with. It can only read the app's database (deploy/mysql/backup-user.sh
# creates it with a new data volume; for a database that already exists run that script once, see README). Restores
# use DB_USER instead. Generate the password like the ones above.
BACKUP_USER=ticketflow_backup
BACKUP_PASSWORD=
# When the daily backup runs (24 h, HH:MM), in the time zone TZ
BACKUP_TIME=02:30
TZ=Europe/Budapest
# How many backups of each kind (database, attachments) to keep; older ones are deleted after a successful run.
# 14 = two weeks. They are on this machine only: copy them somewhere else too (README "Backups").
BACKUP_KEEP=14

# --- API ---
# Signs the login sessions: at least 32 random characters, never a placeholder. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (or: openssl rand -hex 48). Changing it logs everyone out.
JWT_SECRET=

# The address people open the app at (https, no trailing slash), e.g. https://helpdesk.example.com. It must be https:
# the API refuses to start otherwise, and its session cookies are HTTPS-only. Put a reverse proxy or load balancer that
# terminates TLS in front of the web service: docs/https.md (Caddy or nginx + certbot). (Browsers make an exception for
# http://localhost, so a local try-out on http://localhost:8080 works with any https value here.)
CLIENT_URL=https://helpdesk.example.com

# How much the API logs (README "Logs"): fatal, error, warn, info (default), debug, trace or silent. One JSON line per
# entry: docker compose logs api, and docker compose logs api | grep <request id> for one request's lines.
LOG_LEVEL=info
# How many proxies are in front of the API, so it sees each user's real address (login limits, audit log): 1 = the web
# service (nginx) only; 2 = an HTTPS proxy (Caddy or nginx, docs/https.md) in front of it. The HTTPS Compose files set
# 2 themselves. Too few: everyone looks like the proxy and shares one login limit. Too many: a client could fake its
# address.
TRUST_PROXY_HOPS=1

# --- HTTPS (docs/https.md) ---
# Only with docker-compose.https.caddy.yml: the domain (DNS must point at this server), and the email Let's Encrypt
# sends certificate notices to. Never a real address in git: these are placeholders.
# DOMAIN=tickets.example.com
# ACME_EMAIL=admin@example.com
# For the first try, Let's Encrypt's staging CA (certificates browsers don't trust, but generous rate limits). Once it
# works, remove the line and restart caddy: it then gets a real certificate (it keeps each CA's certificates apart)
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# How long browsers must stick to HTTPS, in seconds: 300 to start, 31536000 (a year) once everything works
# HSTS_MAX_AGE=300
# Use the HTTPS file every time without typing -f (pick the one for your option):
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.caddy.yml

# --- Error tracking (optional; README "Error tracking") ---
# Without a DSN nothing is sent anywhere. Make two Sentry projects (Node.js for the API, React for the web app) and put
# each one's DSN here. Only server errors (5xx) and crashes are sent, never personal data.
SENTRY_DSN=
WEB_SENTRY_DSN=
# One name for this deployment, used by both the API and the web app (production, staging, ...)
SENTRY_ENVIRONMENT=production
# Which version an error came from: ticketflow-backend@<commit> and ticketflow-frontend@<commit>, e.g.
#   SENTRY_RELEASE=ticketflow-backend@$(git -C .. rev-parse --short HEAD)
#   WEB_SENTRY_RELEASE=ticketflow-frontend@$(git -C ../../Ctrl-HelpFrontend rev-parse --short HEAD)
# (put the resulting values here). Empty: the API uses ticketflow-backend@<package.json version>.
SENTRY_RELEASE=
WEB_SENTRY_RELEASE=

# --- Web ---
# The port the app is published on, on this machine
WEB_PORT=8080
# The frontend repository, relative to this deploy/ folder (default: next to this repository)
# FRONTEND_DIR=../../Ctrl-HelpFrontend

# --- Email (optional; backend README "Email") ---
# Off by default: emails are only logged, and new or reset passwords are temporary passwords shown to the admin.
# With MAIL_ENABLED=true, SMTP_HOST and MAIL_FROM, they go out as one-time set-password links instead; APP_URL (https)
# is then required too: the address the links point to, usually the same as CLIENT_URL.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true = TLS from the start (usually port 465); false = STARTTLS when the server offers it (587)
SMTP_SECURE=false
# Both, or both empty for a server without login. Never commit real SMTP credentials.
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TicketFlow <no-reply@example.com>"
APP_URL=
# Optional shared IT inbox for new tickets; empty = email every active agent instead
IT_NOTIFY_EMAIL=

# --- Auto-close (optional) ---
# When the daily auto-close job runs; the defaults are 03:00 Europe/Budapest
# AUTO_CLOSE_CRON=0 3 * * *
# AUTO_CLOSE_TIMEZONE=Europe/Budapest
