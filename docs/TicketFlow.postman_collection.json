        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "change-password"]
            },
            "description": "Changes your own password; also clears must_change_password after a temporary password. Body: currentPassword and newPassword (10-72 characters, a letter and a digit). Returns { message: \"Password changed\", user }. A wrong current password returns 400 with code INVALID_CURRENT_PASSWORD (not 401, the session is fine). It ends the user's other sessions; this one continues, because the response sets fresh session cookies.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"password123\",\n  \"newPassword\": \"my-new-password1\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
