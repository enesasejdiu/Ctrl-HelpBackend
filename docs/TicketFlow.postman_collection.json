{
  "info": {
    "name": "TicketFlow API",
    "description": "All TicketFlow backend endpoints. Run `npm run db:seed` first (on a development database), then one of the Login requests. The session is a cookie: login sets `tf_session` (httpOnly) and `tf_csrf`, Postman keeps them in its cookie jar and sends them with every request to the API. The collection's pre-request script copies `tf_csrf` into the `X-CSRF-Token` header on POST, PATCH, PUT and DELETE, which the backend requires. There is no token to copy and no Authorization header (the backend ignores it). Log in as the admin to be allowed every request; Auth → Logout clears the cookies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5050/api"
    },
    {
      "key": "ticketId",
      "value": "1"
    },
    {
      "key": "userId",
      "value": "5"
    },
    {
      "key": "departmentId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": ["{{baseUrl}}"],
          "path": ["health"]
        },
        "auth": {
          "type": "noauth"
        }
      },
      "response": []
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in. The backend sets the tf_session and tf_csrf cookies, which Postman sends with the other requests.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@ticketflow.local\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The session is the tf_session cookie (Postman's cookie jar sends it from now on); the body only has { user }",
                  "pm.test('logged in: the session cookie is set', () => {",
                  "  pm.response.to.have.status(200)",
                  "  pm.expect(pm.cookies.has('tf_session')).to.be.true",
                  "  pm.expect(pm.response.json()).to.not.have.property('token')",
                  "})"
                ]
              }
            }
          ]
        },
        {
          "name": "Login (agent1)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Logs in. The backend sets the tf_session and tf_csrf cookies, which Postman sends with the other requests.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"agent1@ticketflow.local\",\n  \"password\": \"password123\"\n}",
              "options": {
