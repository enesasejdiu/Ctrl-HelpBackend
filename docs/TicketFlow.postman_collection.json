    {
      "name": "Tickets",
      "item": [
        {
          "name": "List tickets",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"],
              "query": [
                {
                  "key": "status",
                  "value": "open",
                  "description": "open | assigned | in_progress | waiting_for_user | resolved | closed | reopened",
                  "disabled": true
                },
                {
                  "key": "priority",
                  "value": "4",
                  "description": "priority id",
                  "disabled": true
                },
                {
                  "key": "category",
                  "value": "1",
                  "description": "category id",
                  "disabled": true
                },
                {
                  "key": "assigned",
                  "value": "me",
                  "description": "me | unassigned",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "wifi",
                  "description": "search in title and description",
                  "disabled": true
                },
                {
                  "key": "overdue",
                  "value": "1",
                  "description": "only overdue tickets",
                  "disabled": true
                }
              ]
            },
            "description": "Employees only get their own tickets. Enable query params to filter."
          },
          "response": []
        },
        {
          "name": "Create ticket",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["tickets"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Keyboard missing keys\",\n  \"description\": \"The E and R keys came off my keyboard.\",\n  \"category_id\": 1,\n  \"priority_id\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
