    },
    {
      "name": "Statistics",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/stats",
          "host": ["{{baseUrl}}"],
          "path": ["stats"]
        },
        "description": "Admin only."
      },
      "response": []
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Changes need the CSRF header: copy the tf_csrf cookie (set at login) into X-CSRF-Token",
          "if (['POST', 'PATCH', 'PUT', 'DELETE'].includes(pm.request.method)) {",
          "  const csrf = pm.cookies.get('tf_csrf')",
          "  if (csrf) pm.request.headers.upsert({ key: 'X-CSRF-Token', value: csrf })",
          "}"
        ]
      }
    }
  ]
}
